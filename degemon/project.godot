config_version=5

[application]

config/name="Degemon"
run/main_scene="uid://caykslwtp2uew"
config/features=PackedStringArray("4.5", "Mobile")
config/icon="res://icon.svg"

[autoload]

World="*res://scripts/global/world.gd"
Embellishments="*res://scripts/global/embellishments.gd"
Sound_Master="*res://scripts/global/sound_master.gd"
Music_Master="*res://scripts/global/music_master.gd"

[display]

