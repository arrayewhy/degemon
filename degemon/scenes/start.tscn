[sub_resource type="ShaderMaterial" id="ShaderMaterial_bodal"]
shader = ExtResource("2_u80x2")
shader_parameter/speed = 1.0
shader_parameter/force_white = 0.0

[sub_resource type="GDScript" id="GDScript_tn317"]
resource_name = "?"
script/source = "extends Sprite2D

const _delay:float = .5;


func _ready() -> void:
	_Change_Frame();


func _Change_Frame() -> void:
	await get_tree().create_timer(_delay).timeout;
	self.offset.y += -1;
	await get_tree().create_timer(_delay).timeout;
	self.offset.y += 1;
	_Change_Frame();
"

[sub_resource type="GDScript" id="GDScript_0auqf"]
resource_name = "idle_loop"
script/source = "extends Sprite2D

@export var _delay:float = .5;


func _ready() -> void:
	_Change_Frame();


func _Change_Frame() -> void:
	self.frame = 1;
	await get_tree().create_timer(_delay).timeout;
	self.frame = 0;
	await get_tree().create_timer(_delay).timeout;
	_Change_Frame();
"

