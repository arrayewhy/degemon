[sub_resource type="GDScript" id="GDScript_naajo"]
resource_name = "Flash"
script/source = "extends TextureRect


func _ready() -> void:
	self.visibility_changed.connect(_Flash);

func _Flash() -> void:
	self.material.set_shader_parameter(\"speed\", 5);
	await get_tree().create_timer(1).timeout;
	self.material.set_shader_parameter(\"speed\", 0);
	self.material.set_shader_parameter(\"force_white\", 1);
	
	self.visibility_changed.disconnect(_Flash);
"

